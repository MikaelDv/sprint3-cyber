# Copie para .env (cp .env.example .env). O .env não vai para o Git.
# Valores para o ambiente LOCAL com o MySQL do monitoring/docker-compose.yml.

# Banco (container carsearch-mysql)
DB_URL=jdbc:mysql://localhost:3306/carsearch
DB_USER=carsearch_app
DB_PASSWORD=app_local_2026

# IA (opcional para a demo: sem chave a consulta retorna lista vazia, mas é auditada)
GEMINI_API_KEY=

# Servidor (HTTP em dev; HTTPS em produção)
SERVER_PORT=8080
SERVER_SSL_ENABLED=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Swagger (desligue em produção)
SWAGGER_ENABLED=true

# Seed do primeiro ADMIN (executa só se a tabela usuarios estiver vazia)
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@challenge-ford.local
BOOTSTRAP_ADMIN_NOME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=Admin@2026Senha!
