        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Consultas à IA por usuário",
      "description": "Alerta P2 acima de 30 por hora",
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT actor AS 'Usuário', COUNT(*) AS 'Consultas', DATE_FORMAT(MAX(ocorrido_em), '%d/%m %H:%i:%s') AS 'Última'\nFROM audit_log\nWHERE acao = 'CONSULTAR_IA' AND $__timeFilter(ocorrido_em)\nGROUP BY actor\nORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "table",
      "title": "Alterações críticas e acesso a dados",
      "description": "",
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATE_FORMAT(ocorrido_em, '%d/%m %H:%i:%s') AS 'Quando', actor AS 'Usuário', acao AS 'Ação', detalhe AS 'Detalhe', ip AS 'IP'\nFROM audit_log\nWHERE acao IN ('USUARIO_CRIADO','CONSULTA_MASSIVA','CRIAR_VEICULO') AND $__timeFilter(ocorrido_em)\nORDER BY ocorrido_em DESC, id DESC\nLIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 15
      }
    },
    {
      "type": "logs",
      "title": "application.log - IA, retenção e erros",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"challenge-ford\", filename=~\".*application.log\"} |~ \"(?i)gemini|Retenção|level.:.(ERROR|WARN)\"",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 23
      }
    }
  ]
