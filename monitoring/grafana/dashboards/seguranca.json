    {
      "type": "table",
      "title": "Top IPs com falha de login",
      "description": "Fonte: tabela audit_log (MySQL)",
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ip AS 'IP', COUNT(*) AS 'Falhas', DATE_FORMAT(MAX(ocorrido_em), '%d/%m %H:%i:%s') AS 'Última tentativa'\nFROM audit_log\nWHERE acao = 'LOGIN' AND resultado IN ('FALHA','BLOQUEADO') AND $__timeFilter(ocorrido_em)\nGROUP BY ip\nORDER BY 2 DESC\nLIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 12,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "logs",
      "title": "security.log (ao vivo)",
      "description": "Payload suspeito, brute-force, bloqueio de conta, rate limit e HMAC",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"challenge-ford\", filename=~\".*security.log\"}",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 8,
        "y": 15
      }
    },
    {
      "type": "table",
      "title": "Trilha de auditoria - últimos 20 eventos",
      "description": "Fonte: tabela audit_log (MySQL)",
      "datasource": {
        "type": "mysql",
        "uid": "mysql"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "mysql"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT DATE_FORMAT(ocorrido_em, '%d/%m %H:%i:%s') AS 'Quando', actor AS 'Usuário', acao AS 'Ação', resultado AS 'Resultado',\n       recurso AS 'Recurso', ip AS 'IP', detalhe AS 'Detalhe', request_id AS 'requestId'\nFROM audit_log\nWHERE $__timeFilter(ocorrido_em)\nORDER BY ocorrido_em DESC, id DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 14,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      }
