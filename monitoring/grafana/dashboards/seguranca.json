      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (http_server_requests_seconds_count{status=~\"400|401|403|429\"}) - (sum by (status) (http_server_requests_seconds_count{status=~\"400|401|403|429\"} offset 1m) or sum by (status) (http_server_requests_seconds_count{status=~\"400|401|403|429\"}) * 0)",
          "editorMode": "code",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "instant": false
